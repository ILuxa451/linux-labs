#!/bin/bash
# {{ ansible_managed }}
export RESTIC_REPOSITORY="{{ restic_repo }}"
export RESTIC_PASSWORD="{{ restic_password }}"
export AWS_ACCESS_KEY_ID="{{ minio_access_key }}"
export AWS_SECRET_ACCESS_KEY="{{ minio_secret_key }}"

LOG_FILE="/var/log/restic-backup.log"
METRIC_FILE="/var/lib/prometheus/node-exporter/restic.prom"

echo "$(date): Starting cloud backup" >> $LOG_FILE

# Если репозиторий не инициализирован — инициализируем
/usr/bin/restic cat config >/dev/null 2>&1 || /usr/bin/restic init >> $LOG_FILE 2>&1

# Бэкап
/usr/bin/restic backup {{ restic_source_dirs }} >> $LOG_FILE 2>&1
BACKUP_RC=$?

# Очистка старых снапшотов (GFS)
/usr/bin/restic forget --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune >> $LOG_FILE 2>&1

# Проверка целостности раз в неделю (в воскресенье)
if [ $(date +%u) -eq 7 ]; then
    /usr/bin/restic check >> $LOG_FILE 2>&1
chmod 0644 $METRIC_FILE
fi

echo "$(date): Cloud backup finished (rc=$BACKUP_RC)" >> $LOG_FILE

# Запись метрик для Prometheus node_exporter
if [ $BACKUP_RC -eq 0 ]; then
    cat << METRICS > $METRIC_FILE
# HELP restic_backup_success Status of last Restic cloud backup (1 = success, 0 = failed)
# TYPE restic_backup_success gauge
restic_backup_success 1
# HELP restic_backup_timestamp Timestamp of last successful Restic cloud backup
# TYPE restic_backup_timestamp gauge
restic_backup_timestamp $(date +%s)
METRICS
else
    cat << METRICS > $METRIC_FILE
# HELP restic_backup_success Status of last Restic cloud backup (1 = success, 0 = failed)
# TYPE restic_backup_success gauge
restic_backup_success 0
METRICS
chmod 0644 $METRIC_FILE
fi
