# {{ ansible_managed }}
# Grafana configuration file
# Generated by Ansible for {{ inventory_hostname }}

[paths]
data = {{ grafana_data_path }}
logs = {{ grafana_logs_path }}
plugins = {{ grafana_install_path }}/current/data/plugins
provisioning = {{ grafana_config_path }}/provisioning

[server]
protocol = http
http_addr = {{ grafana_server_listen }}
http_port = {{ grafana_port }}
{% if grafana_server_domain %}
domain = {{ grafana_server_domain }}
root_url = https://{{ grafana_server_domain }}
{% endif %}

[security]
admin_user = {{ grafana_admin_user }}
admin_password = {{ grafana_admin_password }}

{% if grafana_anonymous_enabled %}
[auth.anonymous]
enabled = true
org_role = Viewer
{% endif %}

[users]
default_theme = light
allow_sign_up = false

[log]
mode = console file
level = info

{% if grafana_smtp_enabled %}
[smtp]
enabled = true
host = {{ grafana_smtp_host }}
user = {{ grafana_smtp_user }}
password = {{ grafana_smtp_password }}
from_address = {{ grafana_smtp_from }}
skip_verify = false
{% endif %}
