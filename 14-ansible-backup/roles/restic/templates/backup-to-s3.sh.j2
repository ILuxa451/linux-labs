#!/bin/bash
# {{ ansible_managed }}
export RESTIC_REPOSITORY="{{ restic_repo }}"
export RESTIC_PASSWORD="{{ restic_password }}"
export AWS_ACCESS_KEY_ID="{{ minio_access_key }}"
export AWS_SECRET_ACCESS_KEY="{{ minio_secret_key }}"

LOG_FILE="/var/log/restic-backup.log"

echo "$(date): Starting S3 backup" >> $LOG_FILE
/usr/bin/restic backup {{ restic_source_dirs }} >> $LOG_FILE 2>&1
/usr/bin/restic forget --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune >> $LOG_FILE 2>&1
echo "$(date): S3 backup finished" >> $LOG_FILE
